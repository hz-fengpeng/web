{
  "name": "economic-indicators",
  "version": "0.1.0",
  "private": true,
  "description": "中国宏观经济数据看板",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:electron": "node scripts/dev.mjs --setup",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:py": "cd fetcher && python3 -m unittest discover -s tests -t .",
    "catalog:export": "node fetcher/tools/export-catalog.mjs && node fetcher/tools/export-periods.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "echarts": "^6.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
